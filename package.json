{
  "name": "rulemap",
  "version": "0.1.0",
  "description": "See which instructions your coding agent loads, and why. Local visual debugger for AGENTS.md, CLAUDE.md, Cursor and Copilot rules.",
  "type": "module",
  "bin": {
    "rulemap": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/types/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist-web",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "tsc --noEmit && eslint src scripts tests playwright.config.ts vite.config.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "agents-md",
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "ai",
    "developer-tools",
    "instructions",
    "debugger"
  ],
  "author": "Mansoor Mamnoon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mansoor-mamnoon/rulemap.git"
  },
  "homepage": "https://mansoor-mamnoon.github.io/rulemap/",
  "bugs": {
    "url": "https://github.com/mansoor-mamnoon/rulemap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "minimatch": "^10.2.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
